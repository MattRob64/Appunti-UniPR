<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.robuschi.MainController"
            id="mainPane">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <top>
        <VBox styleClass="mainBox" spacing="10">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <HBox spacing="10">
                <Label styleClass="mainTitle" text="Product Management" >
                </Label>

                <Label styleClass="mainTitle" fx:id="userLabel" text="(User)">
                </Label>
            </HBox>

            <HBox spacing="10">
                <Button id="refreshButton"
                        text="Refresh Products"
                        onAction="#handleRefresh"/>

                <Button id="addButton"
                        text="Add New Product"
                        onAction="#handleAddProduct"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button id="logoutButton"
                        text="Logout"
                        onAction="#handleLogout"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="15">
            <padding>
                <Insets top="10" right="0" bottom="0" left="0"/>
            </padding>

            <VBox styleClass="mainBox" spacing="10" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <Label styleClass="mainLabel" text="Available Products"/>

                <ListView styleClass="mainList" fx:id="availableProductsList" VBox.vgrow="ALWAYS"/>

                <Button id="purchaseButton"
                        text="Purchase Selected"
                        onAction="#handlePurchase"
                        maxWidth="Infinity"/>
            </VBox>

            <VBox styleClass="mainBox" spacing="10" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <Label styleClass="mainLabel" text="My Purchased Products"/>

                <ListView styleClass="mainList" fx:id="purchasedProductsList" VBox.vgrow="ALWAYS"/>

                <Button id="returnButton"
                        text="Return Selected"
                        onAction="#handleReturn"
                        maxWidth="Infinity"/>
            </VBox>
        </HBox>
    </center>

</BorderPane>